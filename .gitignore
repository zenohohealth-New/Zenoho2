!.vscode/extensions.json
*.swp

# --- Caches ---
.cache/
.eslintcache
.turbo/

# --- Handoff files (D-029): local only, never committed to a public repo ---
HANDOFF-*.md

# --- Supabase CLI staging area ---
# D-044: backend/supabase/migrations/ is now the ONE canonical, TRACKED home for
# migrations, and is deliberately NOT ignored here. Ignoring it is what caused
# the T-004A near-miss: the repo held the migration, the CLI read a different
# directory, and `db push` reported "up to date" having applied nothing.
#
# backend/functions/ is still the canonical source for edge functions and is
# copied into supabase/functions/ at deploy time. That copy carries the same
# drift risk and is not covered by D-044 - see R-004A.
backend/supabase/functions/
backend/supabase/.temp/

# vitest json reporter output (accidentally committed once in dc8e473)
.vitest/
