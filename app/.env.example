# Zenoho2 — app environment (T-003).
#
# Copy to `.env` (exactly that name — Expo does not read `.env.txt`) and fill in
# the real values. `.env` is gitignored; never commit it, never paste keys in chat.
#
# Both variables are EXPO_PUBLIC_*, so their values are inlined into the JS bundle
# at build time. That is correct for these two and only these two: the project URL
# and the publishable key are public by design, and are protected by row-level
# security rather than by secrecy.
#
# NEVER put the service-role / secret key (sb_secret_...) here. It bypasses RLS
# entirely. It belongs only in the Supabase dashboard and in edge-function secrets.

# Your project URL, e.g. https://abcdefghijklmnopqrst.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# The NEW-STYLE publishable key: starts with `sb_publishable_`.
# Not the legacy anon JWT (which starts with `eyJ`), and not a secret key.
# Paste the value only — no angle brackets, no quotes.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
